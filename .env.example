# Copy to .env and fill in. Real environment variables always override .env.

PORT=3000
# development | production (production forces Secure cookies)
NODE_ENV=development
# Business time zone for the dashboard "today" / "pending" / "future" buckets
APP_TIMEZONE=Asia/Kolkata

# MySQL - prod_api_terraterri (Prisma ORM). The MySQL server's time_zone must be
# UTC (the Cloud SQL default): Prisma does not set the session time zone and
# created_at TIMESTAMP columns are read and written as UTC.
# Prisma connection URL - URL-encode special characters in the password.
# e.g. mysql://USERNAME:PASSWORD@HOST:3306/DATABASE?connection_limit=10
DATABASE_URL=
# Used to build the connection only when DATABASE_URL is empty.
# Local machine -> live Cloud SQL: run the Cloud SQL Auth Proxy first
#   cloud-sql-proxy.exe terraterri-454406:asia-south1:shared-laravel-db --port 3306
# then DB_HOST=127.0.0.1 and DB_PORT=3306 (host and port in separate variables).
# Cloud Run: DB_HOST=/cloudsql/terraterri-454406:asia-south1:shared-laravel-db (Unix socket, DB_PORT unused)
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# AirproX CRM authentication (JWT in an HttpOnly cookie)
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Seconds (86400) or a timespan (1d, 12h)
JWT_EXPIRES_IN=1d
JWT_COOKIE_NAME=airpropx_token
# lax | strict | none (none requires HTTPS and forces Secure)
JWT_COOKIE_SAMESITE=lax
# true on HTTPS; false only for plain-HTTP local development
JWT_COOKIE_SECURE=false
# Optional, e.g. .airpropx.com when the UI and API are on sibling subdomains
JWT_COOKIE_DOMAIN=
# Comma separated browser origins allowed to call /api/v1/airpropx with cookies (no "*")
AIRPROPX_CORS_ALLOWED_ORIGINS=

# Login OTP (stored in user_otps). The SMS text states the expiry, so keep 5
# unless a DLT template with a different duration is registered.
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Limits per mobile number within OTP_RATE_LIMIT_WINDOW_MINUTES
OTP_MAX_REQUESTS=5
OTP_MAX_FAILED_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# SMS provider - same variables as nodeapi-services-terraterri (HTTPS)
SMS_HOST=
SMS_PORT=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=
SMS_ENTITY_ID=
SMS_TMID=
# DLT template id of the OTP SMS text (the one nodeapi-services-terraterri uses)
SMS_OTP_TEMPLATE_ID=1707174625464679504

# Lead import: maximum rows per request
IMPORT_MAX_ROWS=5000
# Verify the provider's TLS certificate (default true). false skips the check,
# as nodeapi-services-terraterri does - only when the provider's certificate
# is not valid for SMS_HOST.
SMS_TLS_REJECT_UNAUTHORIZED=true
