    "_postman_id": "6f3c2a1e-8d4b-4c7a-9e2f-1a5b7c9d0e21",
    "name": "AirproX CRM API",
    "description": "AirproX CRM Node.js APIs. Verify OTP sets the airpropx_token cookie; Postman keeps it, so run Auth > Request OTP, put the SMS code in the `otp` variable, run Verify OTP, then use any other request. Everything except Health needs that login. Full reference: Docs/AuthDashboardApi.md and Docs/CrmApi.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
