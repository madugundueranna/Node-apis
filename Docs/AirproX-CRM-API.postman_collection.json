  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"role\": \"{{role}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "request-otp"
              ]
            },
            "description": "Sends a 6-digit OTP (valid 5 minutes) by SMS to a mobile number that belongs to an active account with the requested role.\n\nrole: \"Sales Director\" or \"Franchise Sales Manager\"\n\n200 OTP sent successfully\n400 validation (missing fields, invalid mobile, Invalid role)\n401 Invalid mobile number or role\n403 account inactive / no login access\n409 multiple active accounts\n429 cooldown (30 s) or too many OTP requests\n502 SMS provider failed / not configured\n503 database unavailable"
          },
          "response": []
        },
        {
          "name": "Verify OTP (Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"role\": \"{{role}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Verifies the OTP for the same mobile + role and logs in. Sets the HttpOnly cookie airpropx_token (the JWT is never in the body). The OTP can be used once.\n\n200 Login Successful - data: authenticated, expiresAt, user, permissions, shortcuts\n400 missing OTP / Please enter a valid 6-digit OTP\n401 Invalid OTP / OTP expired / OTP not found or expired / Invalid mobile number or role\n403 / 409 account errors (same as Request OTP)\n429 Too many failed OTP attempts"
          },
          "response": []
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Logged-in user from the cookie (reloaded by the token's user id and role).\n\n200 User details fetched successfully - data: authenticated, expiresAt, user, permissions, shortcuts\n401 Authentication required / session expired / invalid session / access revoked"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Clears the airpropx_token cookie. Always 200 Logout Successful."
          },
          "response": []
        }
      ]
    },
